# v2rayN Web environment example
#
# Copy this file to .env before starting:
#
#   cp .env.example .env
#   ./v2rayN.Web
#
# Native interactive installs may leave V2RAYN_WEB_API_KEY empty and configure
# the Management Key from the Web UI on first launch.
# Supervised/systemd/container deployments require a non-empty Management Key.

V2RAYN_WEB_API_KEY=

# Optional generic static WebUI directory. Unset uses ./webui beside v2rayN.Web.
# An explicitly empty value disables static WebUI hosting.
# Relative paths are resolved from the directory containing v2rayN.Web, not the current directory.
# V2RAYN_WEB_UI_PATH=/opt/v2rayn/webui

# Web management interface. The default intentionally listens on all interfaces.
ASPNETCORE_URLS=http://0.0.0.0:5080

# Start the selected Core automatically after authentication setup.
V2RAYN_WEB_AUTOSTART=true

# Optional proxy listener port.
# V2RAYN_WEB_PROXY_PORT=10808

# Allow proxy clients outside localhost.
# V2RAYN_WEB_PROXY_LISTEN_ALL=false

# Optional writable data directory.
# V2RAYN_DATA_HOME=/path/to/v2rayn-data
