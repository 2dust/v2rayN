                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="gridFinalmask" Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbFinalmask}" />
                        <Expander
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Stretch"
                            Header="{x:Static resx:ResUI.TbFinalmask}"
                            IsExpanded="False"
                            Style="{StaticResource FlatExpander}">
                            <TextBox
                                x:Name="txtFinalmask"
                                MinHeight="120"
                                AcceptsReturn="True"
                                HorizontalScrollBarVisibility="Auto"
                                Style="{StaticResource MyOutlinedTextBox}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </Grid>

                    <Separator
                        Grid.Row="7"
                        Margin="0,8"
                        Style="{DynamicResource MaterialDesignSeparator}" />
                    <Grid x:Name="gridTls" Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbStreamSecurity}" />
                        <ComboBox
                            x:Name="cmbStreamSecurity"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="220"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefComboBox}" />
                    </Grid>

                    <Grid
                        x:Name="gridTlsMore"
                        Grid.Row="9"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbSNI}" />
                        <TextBox
                            x:Name="txtSNI"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbFingerprint}" />
                        <ComboBox
                            x:Name="cmbFingerprint"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="220"
                            Margin="{StaticResource Margin4}"
                            IsEditable="True"
                            Style="{StaticResource DefComboBox}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbAlpn}" />
                        <ComboBox
                            x:Name="cmbAlpn"
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="220"
                            Margin="{StaticResource Margin4}"
                            IsEditable="True"
                            Style="{StaticResource DefComboBox}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbAllowInsecure}" />
                        <ToggleButton
                            x:Name="togAllowInsecure"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbEchConfigList}" />
                        <TextBox
                            x:Name="txtEchConfigList"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbVerifyPeerCertByName}" />
                        <TextBox
                            x:Name="txtVerifyPeerCertByName"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbCertPinning}" />
                        <Grid Grid.Row="6" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="labCertPinning"
                                Grid.Column="0"
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarTextBlock}"
                                TextWrapping="Wrap" />
                            <materialDesign:PopupBox
                                Grid.Column="1"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                StaysOpen="True"
                                Style="{StaticResource MaterialDesignToolForegroundPopupBox}">
                                <StackPanel>
                                    <TextBlock
                                        Width="400"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbCertPinningTips}"
                                        TextWrapping="Wrap" />
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                        <Button
                                            x:Name="btnFetchCert"
                                            Margin="{StaticResource MarginLeftRight4}"
                                            Content="{x:Static resx:ResUI.TbFetchCert}"
                                            Style="{StaticResource DefButton}" />
                                        <Button
                                            x:Name="btnFetchCertChain"
                                            Margin="{StaticResource MarginLeftRight4}"
                                            Content="{x:Static resx:ResUI.TbFetchCertChain}"
                                            Style="{StaticResource DefButton}" />
                                    </StackPanel>
                                    <TextBlock
                                        Width="400"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        TextWrapping="Wrap">
                                        <Run Text="{x:Static resx:ResUI.TbCertSha256Tips}" />
                                        <Run FontWeight="Bold" Text="{x:Static resx:ResUI.TbXrayOnly}" />
                                    </TextBlock>
                                    <TextBox
                                        x:Name="txtCertSha256Pinning"
                                        Width="400"
                                        Margin="{StaticResource Margin4}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource DefTextBox}" />
                                    <TextBlock
                                        Width="400"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbFullCertTips}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="txtCert"
                                        Width="400"
                                        Margin="{StaticResource Margin4}"
                                        AcceptsReturn="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        MaxLines="18"
                                        MinLines="6"
                                        Style="{StaticResource MyOutlinedTextBox}"
                                        TextWrapping="NoWrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="gridRealityMore"
                        Grid.Row="9"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbSNI}" />
                        <TextBox
                            x:Name="txtSNI2"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbFingerprint}" />
                        <ComboBox
                            x:Name="cmbFingerprint2"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="220"
                            Margin="{StaticResource Margin4}"
                            IsEditable="True"
                            Style="{StaticResource DefComboBox}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbPublicKey}" />
                        <TextBox
                            x:Name="txtPublicKey"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbShortId}" />
                        <TextBox
                            x:Name="txtShortId"
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="220"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbSpiderX}" />
                        <TextBox
                            x:Name="txtSpiderX"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Style="{StaticResource FormLabel}"
                            Text="{x:Static resx:ResUI.TbMldsa65Verify}" />
                        <TextBox
                            x:Name="txtMldsa65Verify"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefTextBox}" />
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
