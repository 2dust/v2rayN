<base:WindowBase
    x:Class="v2rayN.Views.WorkflowWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuWorkflowSetting}"
    Width="900"
    Height="600"
    x:TypeArguments="vms:WorkflowViewModel"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True"
                Style="{StaticResource MaterialDesignToolBar}">
                <Button x:Name="menuWorkflowAdd">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="{StaticResource MarginRight8}"
                            VerticalAlignment="Center"
                            Kind="Plus" />
                        <TextBlock Style="{StaticResource ToolbarTextBlock}" Text="{x:Static resx:ResUI.menuWorkflowAdd}" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button x:Name="menuWorkflowEdit">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="{StaticResource MarginRight8}"
                            VerticalAlignment="Center"
                            Kind="Edit" />
                        <TextBlock Style="{StaticResource ToolbarTextBlock}" Text="{x:Static resx:ResUI.menuWorkflowEdit}" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button x:Name="menuWorkflowDelete">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="{StaticResource MarginRight8}"
                            VerticalAlignment="Center"
                            Kind="Delete" />
                        <TextBlock Style="{StaticResource ToolbarTextBlock}" Text="{x:Static resx:ResUI.menuWorkflowDelete}" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button x:Name="menuWorkflowRun">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="{StaticResource MarginRight8}"
                            VerticalAlignment="Center"
                            Kind="Play" />
                        <TextBlock Style="{StaticResource ToolbarTextBlock}" Text="{x:Static resx:ResUI.menuWorkflowRun}" />
                    </StackPanel>
                </Button>
                <Button x:Name="menuClose" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="{StaticResource MarginRight8}"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock Style="{StaticResource ToolbarTextBlock}" Text="{x:Static resx:ResUI.menuClose}" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>
        <DataGrid
            x:Name="lstWorkflow"
            AutoGenerateColumns="False"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            IsReadOnly="True"
            Style="{StaticResource DefDataGrid}">
            <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource DefContextMenu}">
                    <MenuItem
                        x:Name="menuWorkflowAdd2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuWorkflowAdd}" />
                    <MenuItem
                        x:Name="menuWorkflowEdit2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuWorkflowEdit}" />
                    <MenuItem
                        x:Name="menuWorkflowDelete2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuWorkflowDelete}" />
                    <MenuItem
                        x:Name="menuWorkflowRun2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuWorkflowRun}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Remarks}"
                    Header="{x:Static resx:ResUI.LvWorkflowRemarks}" />
                <DataGridCheckBoxColumn
                    Width="100"
                    Binding="{Binding Enabled}"
                    Header="{x:Static resx:ResUI.LvWorkflowEnabled}" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Sort}"
                    Header="{x:Static resx:ResUI.LvWorkflowSort}" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding StepsDisplay}"
                    Header="{x:Static resx:ResUI.LvWorkflowSteps}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</base:WindowBase>
