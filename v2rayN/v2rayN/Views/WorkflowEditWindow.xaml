<base:WindowBase
    x:Class="v2rayN.Views.WorkflowEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuWorkflowSetting}"
    Width="820"
    Height="620"
    x:TypeArguments="vms:WorkflowEditViewModel"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource Margin8}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="{StaticResource Margin8}"
            Orientation="Horizontal">
            <TextBlock
                Margin="{StaticResource MarginRight8}"
                VerticalAlignment="Center"
                Text="{x:Static resx:ResUI.LvWorkflowRemarks}" />
            <TextBox
                x:Name="txtRemarks"
                Width="320"
                VerticalAlignment="Center" />
            <CheckBox
                x:Name="togEnable"
                Margin="{StaticResource MarginLeftRight8}"
                VerticalAlignment="Center"
                Content="{x:Static resx:ResUI.LvWorkflowEnabled}" />
        </StackPanel>

        <ToolBarTray Grid.Row="1" DockPanel.Dock="Top">
            <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                <Button
                    x:Name="btnAddStep"
                    Content="{x:Static resx:ResUI.WorkflowStepAdd}"
                    Style="{StaticResource DefButton}" />
                <Button
                    x:Name="btnDeleteStep"
                    Content="{x:Static resx:ResUI.WorkflowStepDelete}"
                    Style="{StaticResource DefButton}" />
                <Button
                    x:Name="btnStepUp"
                    Content="{x:Static resx:ResUI.WorkflowStepUp}"
                    Style="{StaticResource DefButton}" />
                <Button
                    x:Name="btnStepDown"
                    Content="{x:Static resx:ResUI.WorkflowStepDown}"
                    Style="{StaticResource DefButton}" />
            </ToolBar>
        </ToolBarTray>

        <DataGrid
            x:Name="lstSteps"
            Grid.Row="2"
            AutoGenerateColumns="False"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            Style="{StaticResource DefDataGrid}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding Enabled}"
                    Header="{x:Static resx:ResUI.WorkflowStepEnabled}" />
                <DataGridTemplateColumn
                    Width="200"
                    Header="{x:Static resx:ResUI.WorkflowStepAction}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding ActionOptions}"
                                SelectedItem="{Binding ActionDisplay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignDataGridComboBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="200"
                    Header="{x:Static resx:ResUI.WorkflowStepSub}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding GroupOptions}"
                                SelectedItem="{Binding SubDisplay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignDataGridComboBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="*"
                    Header="{x:Static resx:ResUI.WorkflowStepParameter}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding ParameterOptions}"
                                IsEnabled="{Binding HasParameter}"
                                SelectedItem="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignDataGridComboBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn
                    Width="110"
                    Binding="{Binding BoolParameter, UpdateSourceTrigger=PropertyChanged}"
                    Header="{x:Static resx:ResUI.WorkflowParamHint}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="3"
            Margin="{StaticResource Margin8}"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Content="{x:Static resx:ResUI.TbConfirm}"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                Content="{x:Static resx:ResUI.TbCancel}"
                Style="{StaticResource DefButton}" />
        </StackPanel>
    </Grid>
</base:WindowBase>
