[Unit]
Description=v2rayN Headless Web Frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=v2rayn
Group=v2rayn
WorkingDirectory=/opt/v2rayn-web
ExecStart=/opt/v2rayn-web/v2rayN.Web --foreground
EnvironmentFile=/etc/v2rayn-web.env
Environment=ASPNETCORE_URLS=http://0.0.0.0:5080
Environment=V2RAYN_WEB_AUTOSTART=true
Environment=V2RAYN_DATA_HOME=/var/lib/v2rayn-web
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/v2rayn-web/.net-bundle
StateDirectory=v2rayn-web
StateDirectoryMode=0750
UMask=0077
Restart=always
RestartSec=3
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/v2rayn-web

[Install]
WantedBy=multi-user.target
