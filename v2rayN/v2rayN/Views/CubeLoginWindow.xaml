<Window
    x:Class="v2rayN.Views.CubeLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.CubeLoginTitle}"
    Width="420"
    Height="380"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource Margin8}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="{StaticResource Margin8}"
            HorizontalAlignment="Center"
            FontSize="18"
            Text="{x:Static resx:ResUI.CubeLoginTitle}" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Margin8}">
            <!--  Step 1: identifier  -->
            <StackPanel x:Name="panelIdentifier">
                <TextBox
                    x:Name="txtIdentifier"
                    Margin="{StaticResource Margin4}"
                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.CubeLoginIdentifierLabel}"
                    Style="{StaticResource MyOutlinedTextBox}" />
                <Button
                    x:Name="btnGetCode"
                    Margin="{StaticResource Margin4}"
                    Content="{x:Static resx:ResUI.CubeLoginGetCode}"
                    IsDefault="True"
                    Style="{StaticResource DefButton}" />
            </StackPanel>

            <!--  Step 2: OTP code  -->
            <StackPanel x:Name="panelCode" Visibility="Collapsed">
                <TextBox
                    x:Name="txtCode"
                    Margin="{StaticResource Margin4}"
                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.CubeLoginCodeLabel}"
                    Style="{StaticResource MyOutlinedTextBox}" />
                <Button
                    x:Name="btnVerify"
                    Margin="{StaticResource Margin4}"
                    Content="{x:Static resx:ResUI.CubeLoginVerify}"
                    IsDefault="True"
                    Style="{StaticResource DefButton}" />
                <Button
                    x:Name="btnResend"
                    Margin="{StaticResource Margin4}"
                    Content="{x:Static resx:ResUI.CubeLoginResend}"
                    Style="{StaticResource DefButton}" />
                <Button
                    x:Name="btnChangeIdentifier"
                    Margin="{StaticResource Margin4}"
                    Content="{x:Static resx:ResUI.CubeLoginChangeIdentifier}"
                    Style="{StaticResource DefButton}" />
            </StackPanel>

            <ProgressBar
                x:Name="progressBusy"
                Height="4"
                Margin="{StaticResource Margin4}"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="txtError"
                Margin="{StaticResource Margin4}"
                Foreground="#EF5350"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
