#!/bin/bash
#
# Process Terminator Script for Linux
# This script forcibly terminates one or more processes and all their child processes
#

# Check if at least one PID argument is provided
if [ $# -lt 1 ]; then
    echo "Usage: $0 <PID> [PID...]"
    exit 1
fi

PIDS="$@"

# Validate that all inputs are valid PIDs (numeric)
for PID in $PIDS; do
    if ! [[ "$PID" =~ ^[0-9]+$ ]]; then
        echo "Error: The PID must be a numeric value"
        exit 1
    fi
done

# Drop the PIDs that are not running anymore
TARGETS=()
for PID in $PIDS; do
    if ps -p "$PID" > /dev/null; then
        TARGETS+=("$PID")
    else
        echo "Warning: No process found with PID $PID"
    fi
done

if [ ${#TARGETS[@]} -eq 0 ]; then
    exit 0
fi

# Collect the whole child trees (deepest first) BEFORE any process is signalled.
# Once the parent dies its children are re-parented to init and can no longer be
# found by walking the ppid chain, so they would survive and keep holding the ports.
DESCENDANTS=()
collect_children() {
    local parent=$1
    local child
    local children=$(ps -o pid --no-headers --ppid "$parent")

    # 'child' must stay local, otherwise the recursive call overwrites the loop
    # variable of this frame and the direct child is never handled
    for child in $children; do
        collect_children "$child"
        DESCENDANTS+=("$child")
    done
}
for PID in "${TARGETS[@]}"; do
    collect_children "$PID"
done

echo "============================================"
echo "Starting termination of processes ${TARGETS[*]} and all their children"
echo "============================================"

# Send SIGKILL directly: a SIGTERM leaves the core draining connections while its
# listener stays open for up to a second, and the port release is instead waited for
# by the bind probing on the caller side.
# The collected children must be terminated before the parents so the listening
# ports are really released, no matter what the parents did.
for child in "${DESCENDANTS[@]}"; do
    if ps -p "$child" > /dev/null; then
        echo "Terminating child process: $child"
        kill -9 "$child" 2>/dev/null || true
    fi
done

# Finally kill the main processes
for PID in "${TARGETS[@]}"; do
    if ps -p "$PID" > /dev/null; then
        echo "Terminating main process: $PID"
        kill -9 "$PID" 2>/dev/null || true
    else
        echo "Process $PID already exited"
    fi
done

# Wait a little for process/port resources to be fully released
FINAL_WAIT_SECONDS=1
echo "Waiting ${FINAL_WAIT_SECONDS}s for resources to settle..."
sleep "$FINAL_WAIT_SECONDS"

# Verify that nothing survived, otherwise report it as a failure
FAILED=0
for PID in "${TARGETS[@]}" "${DESCENDANTS[@]}"; do
    if ps -p "$PID" > /dev/null; then
        echo "Error: process $PID is still running"
        FAILED=1
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo "============================================"
    echo "Some processes of ${TARGETS[*]} could not be terminated"
    echo "============================================"
    exit 1
fi

echo "============================================"
echo "Processes ${TARGETS[*]} and all their children have been terminated"
echo "============================================"

exit 0
